{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxtool.local/schemas/host-snapshot-v1.schema.json",
  "title": "DocxTool HostSnapshot v1",
  "description": "Host-neutral local paragraph snapshot used for binding a RecognitionPlan.",
  "type": "object",
  "required": [
    "schema_version",
    "integration_contract_version",
    "snapshot_id",
    "host",
    "text_contract_version",
    "offset_encoding",
    "paragraphs"
  ],
  "properties": {
    "schema_version": { "const": "host-snapshot-v1" },
    "integration_contract_version": { "const": "integration-contract-v1" },
    "snapshot_id": { "type": "string", "minLength": 1 },
    "document_identity": { "type": ["string", "null"] },
    "document_revision": { "type": ["string", "null"] },
    "host": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "platform": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "host_type": { "type": "string" },
    "text_contract_version": { "const": "host-text-v1" },
    "offset_encoding": { "const": "utf16_code_unit" },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host_paragraph_id",
          "host_paragraph_index",
          "story_id",
          "story_type",
          "story_paragraph_index",
          "is_in_table",
          "raw_text"
        ],
        "properties": {
          "host_paragraph_id": { "type": "string", "minLength": 1 },
          "host_paragraph_index": { "type": "integer", "minimum": 0 },
          "story_id": { "type": "string", "minLength": 1 },
          "story_type": {
            "enum": ["main", "header", "footer", "footnote", "endnote", "comment", "text_frame", "unknown"]
          },
          "story_paragraph_index": { "type": ["integer", "null"], "minimum": 0 },
          "section_index": { "type": ["integer", "null"], "minimum": 0 },
          "is_in_table": { "type": "boolean" },
          "raw_text": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
