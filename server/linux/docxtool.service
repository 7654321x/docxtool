[Unit]
Description=DocxTool backend service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=docxtool
Group=docxtool
WorkingDirectory=/opt/docxtool
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/docxtool/.venv/bin/python /opt/docxtool/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/docxtool/var

[Install]
WantedBy=multi-user.target
