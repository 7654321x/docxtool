# Server bind address
BIND_HOST=127.0.0.1
PORT=9527

# Python backend secrets. Use long random values in production.
# Example: python scripts/generate_secrets.py
ADMIN_TOKEN=change-me-admin-token
PROXY_SECRET=change-me-proxy-secret
# In production set true. When omitted, HTTPS FRONTEND_ORIGIN defaults to secure cookies.
COOKIE_SECURE=
# Production administrator origin. It must match the HTTPS Cloudflare Pages origin.
# Do not configure a server IP, a direct HTTP administrator origin, or an Origin path.
ADMIN_CONSOLE_ORIGIN=
# In production set true. This affects administrator sessions only.
ADMIN_COOKIE_SECURE=
ADMIN_SESSION_TTL_SECONDS=43200
# Ordinary user sessions are stored server-side; browsers receive an HttpOnly cookie.
DOCXTOOL_USER_SESSION_DAYS=30

# Upload and DOCX safety limits.
DATABASE_PATH=var/data/stats.db
# WPS 插件账号、设备、会话和排版请求使用独立数据库。
WPS_DATABASE_PATH=var/data/wps_plugin.db
MAX_UPLOAD_SIZE_MB=10
MAX_DOCX_UNCOMPRESSED_MB=100
MAX_DOCX_FILE_COUNT=1000
MAX_DOCX_XML_SIZE_MB=20
MAX_DOCX_MEDIA_SIZE_MB=30
MAX_DOCX_COMPRESSION_RATIO=100
PROCESS_TIMEOUT_SECONDS=60
# Accepted originals, generated files, task records, and task logs are kept permanently.
# FILE_RETENTION_HOURS, TASK_RETENTION_HOURS and DOCXTOOL_KEEP_FAILED_INPUTS are ignored.
MAX_CACHED_TASKS=500
CLEANUP_INTERVAL_MINUTES=30

# Trusted local reverse-proxy configuration. Production uses strict boolean parsing.
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional in local development. Production must use the exact Cloudflare Pages origin.
FRONTEND_ORIGIN=https://docx.toolpp.cn
# Set true in production. Invalid security boolean values stop startup.
PRODUCTION_MODE=false

# Cloudflare Pages has exactly two Secrets; configure them in Pages, not in this file.
# BACKEND_BASE_URL=https://origin.toolpp.cn
# PROXY_SECRET=<same value as this backend PROXY_SECRET>
